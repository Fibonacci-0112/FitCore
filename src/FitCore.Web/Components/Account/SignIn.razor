@page "/account/sign-in"
@attribute [ExcludeFromInteractiveRouting]
@inject MemberAuth Auth
@inject MemberSessions Sessions
@inject SignInLimits Limits
@inject NavigationManager Navigation

<PageTitle>@TextFormat.PageTitle(AccountStrings.SignInHeading)</PageTitle>

<h1>@AccountStrings.SignInHeading</h1>

@if (error is not null)
{
    <p role="alert">@error</p>
}

<EditForm Model="Input!" FormName="sign-in" OnValidSubmit="SignInAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <p>
        <label for="email">@AccountStrings.EmailLabel</label>
        <InputText id="email" @bind-Value="Input!.Email" type="email" autocomplete="username" />
    </p>
    <p>
        <label for="password">@AccountStrings.PasswordLabel</label>
        <InputText id="password" @bind-Value="Input!.Password" type="password" autocomplete="current-password" />
    </p>

    <button type="submit">@AccountStrings.SignInButton</button>
</EditForm>

<p><LinkedText Format="@AccountStrings.NewToFitCore" Href="account/sign-up" Text="@AccountStrings.CreateAccountLink" /></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private SignInInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var input = Input!;
        var email = input.Email!.Trim();
        var ip = HttpContext.Connection.RemoteIpAddress;

        // Refused before Supabase Auth is asked, so a locked-out address can't be tried at all (NFR-SEC-4).
        if (await Limits.CheckAttemptAsync(ip) is { } busy)
        {
            error = AccountText.Refuse(HttpContext, busy, AccountStrings.RateLimited);
            return;
        }

        if (await Limits.LockedForAsync(email) is { } locked)
        {
            error = AccountText.Refuse(HttpContext, locked, AccountStrings.SignInLocked);
            return;
        }

        var outcome = await Auth.SignInWithPasswordAsync(email, input.Password!, ip, HttpContext.RequestAborted);

        if (outcome.Status == AuthStatus.SignedIn)
        {
            await Limits.RecordSuccessAsync(email);
            Sessions.Start(HttpContext, outcome.Session!);
            Navigation.NavigateTo(AccountText.LocalOrHome(ReturnUrl), forceLoad: true);
            return;
        }

        if (outcome.Status == AuthStatus.InvalidCredentials && await Limits.RecordFailureAsync(email) is { } lockout)
        {
            error = AccountText.Refuse(HttpContext, lockout, AccountStrings.SignInLocked);
            return;
        }

        error = AccountText.For(outcome.Status);
    }

    private sealed class SignInInput
    {
        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.EmailInvalid))]
        public string? Email { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.CurrentPasswordRequired))]
        public string? Password { get; set; }
    }
}
