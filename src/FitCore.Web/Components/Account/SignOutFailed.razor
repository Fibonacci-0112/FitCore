@page "/account/sign-out-failed"
@attribute [ExcludeFromInteractiveRouting]

@* Sign-out keeps the session when Supabase can't revoke it, so a copied cookie can't outlive the member's sign-out (NFR-SEC-4). *@

<PageTitle>@TextFormat.PageTitle(AccountStrings.SignOutFailedTitle)</PageTitle>

<h1>@AccountStrings.SignOutFailedHeading</h1>
<p>@AccountStrings.SignOutFailedBody</p>

<form method="post" action="account/sign-out" data-enhance="false">
    <AntiforgeryToken />
    <button type="submit">@AccountStrings.SignOutButton</button>
</form>
