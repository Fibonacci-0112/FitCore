@page "/account/sign-up"
@attribute [ExcludeFromInteractiveRouting]
@using FitCore.Domain.Calendar
@inject MemberAuth Auth
@inject MemberSessions Sessions
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject SignInLimits Limits

<PageTitle>@TextFormat.PageTitle(AccountStrings.SignUpTitle)</PageTitle>

<h1>@AccountStrings.SignUpTitle</h1>

@if (error is not null)
{
    <p role="alert">@error</p>
}

<EditForm Model="Input!" FormName="sign-up" OnValidSubmit="SignUpAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <p>
        <label for="display-name">@AccountStrings.NameLabel</label>
        <InputText id="display-name" @bind-Value="Input!.DisplayName" autocomplete="name" />
    </p>
    <p>
        <label for="email">@AccountStrings.EmailLabel</label>
        <InputText id="email" @bind-Value="Input!.Email" type="email" autocomplete="email" />
    </p>
    <p>
        <label for="password">@AccountStrings.PasswordLabel</label>
        <InputText id="password" @bind-Value="Input!.Password" type="password" autocomplete="new-password" aria-describedby="password-help" />
        <small id="password-help">@AccountStrings.PasswordHelp</small>
    </p>
    <p>
        <label for="birth-date">@AccountStrings.BirthDateLabel</label>
        <InputDate id="birth-date" @bind-Value="Input!.BirthDate" autocomplete="bday" aria-describedby="birth-date-help" />
        <small id="birth-date-help">@AccountStrings.BirthDateHelp</small>
    </p>
    <InputText @bind-Value="Input!.TimeZone" type="hidden" data-time-zone />

    <button type="submit">@AccountStrings.CreateAccount</button>
</EditForm>

<p><LinkedText Format="@AccountStrings.HaveAccount" Href="account/sign-in" Text="@AccountStrings.SignInLink" /></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private SignUpInput? Input { get; set; }

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignUpAsync()
    {
        // The browser's time zone, if it sent a real one; the member can change it later.
        var zone = TimeZoneInfo.TryFindSystemTimeZoneById(Input!.TimeZone ?? "", out var found) ? found : TimeZoneInfo.Utc;
        var birthDate = Input.BirthDate!.Value;

        // Checked here for a clear message; the database refuses an under-18 birth date whatever the caller.
        if (!LocalCalendar.IsOldEnough(birthDate, LocalCalendar.DateAt(Time.GetUtcNow(), zone)))
        {
            error = AccountStrings.TooYoung;
            return;
        }

        if (await Limits.CheckAttemptAsync(HttpContext.Connection.RemoteIpAddress) is { } busy)
        {
            error = AccountText.Refuse(HttpContext, busy, AccountStrings.RateLimited);
            return;
        }

        var outcome = await Auth.SignUpAsync(
            Input.Email!.Trim(),
            Input.Password!,
            new SignUpProfile(Input.DisplayName!.Trim(), birthDate, zone.Id),
            HttpContext.Connection.RemoteIpAddress,
            HttpContext.RequestAborted);

        switch (outcome.Status)
        {
            case AuthStatus.SignedIn:
                Sessions.Start(HttpContext, outcome.Session!);
                Navigation.NavigateTo("/", forceLoad: true);
                break;
            case AuthStatus.ConfirmationSent:
                Navigation.NavigateTo("account/check-email", forceLoad: true);
                break;
            default:
                error = AccountText.For(outcome.Status);
                break;
        }
    }

    private sealed class SignUpInput
    {
        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.NameRequired))]
        [StringLength(80, ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.NameTooLong))]
        public string? DisplayName { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.EmailInvalid))]
        [StringLength(254, ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.EmailTooLong))]
        public string? Email { get; set; }

        // NFR-SEC-2: at least 15 characters as the only factor, up to 64 allowed, no composition rules.
        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.PasswordRequired))]
        [StringLength(64, MinimumLength = 15, ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.PasswordLength))]
        public string? Password { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountStrings), ErrorMessageResourceName = nameof(AccountStrings.BirthDateRequired))]
        public DateOnly? BirthDate { get; set; }

        public string? TimeZone { get; set; }
    }
}
