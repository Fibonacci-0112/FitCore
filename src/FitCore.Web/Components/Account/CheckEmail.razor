@page "/account/check-email"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>@TextFormat.PageTitle(AccountStrings.CheckEmailTitle)</PageTitle>

<h1>@AccountStrings.CheckEmailTitle</h1>
