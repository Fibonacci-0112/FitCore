<?xml version="1.0" encoding="utf-8" ?>
<!-- Shown at launch while AppShell looks for a saved session, so neither sign-in nor home flashes up first. -->
<ContentPage x:Class="FitCore.Maui.Pages.StartPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:FitCore.Client.Core.Resources;assembly=FitCore.Client.Core"
             Title="{x:Static strings:ShellStrings.AppName}"
             Shell.NavBarIsVisible="False">

    <ActivityIndicator IsRunning="True"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       SemanticProperties.Description="{x:Static strings:ShellStrings.Starting}" />

</ContentPage>
