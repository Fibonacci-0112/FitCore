<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The app's navigation. It opens on the start page while AppShell looks for a saved session, then shows sign-in or
    home. A signed-out member reaches only the account screens. The signed-in tabs join here as the R1 screens land.
-->
<Shell x:Class="FitCore.Maui.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:FitCore.Maui.Pages"
       xmlns:strings="clr-namespace:FitCore.Client.Core.Resources;assembly=FitCore.Client.Core"
       Title="{x:Static strings:ShellStrings.AppName}"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="start"
                  ContentTemplate="{DataTemplate pages:StartPage}" />

    <ShellContent Route="sign-in"
                  ContentTemplate="{DataTemplate pages:SignInPage}" />

    <ShellContent Route="sign-up"
                  ContentTemplate="{DataTemplate pages:SignUpPage}" />

    <ShellContent Route="home"
                  ContentTemplate="{DataTemplate pages:HomePage}" />

</Shell>
