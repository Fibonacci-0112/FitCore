<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The device app: .NET MAUI with XAML on Android, iOS, macOS and Windows (BRD §5, NFR-CMP-1). Screens bind to the
    view models in FitCore.Client.Core; no business logic lives here (NFR-MNT-4). Each platform builds on a machine
    that can: Android everywhere, iOS and macOS on a Mac, Windows on Windows.
  -->

  <PropertyGroup>
    <!-- Clears Directory.Build.props' single target framework for these. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FitCore.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>FitCore</ApplicationTitle>
    <ApplicationId>app.fitcore</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <!-- NFR-CMP-1: iOS and iPadOS 17+, Android 10 (API 29)+, macOS 13+ (Mac Catalyst 16.1), Windows 10 22H2 and Windows 11. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">16.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    The Supabase project the app signs members in with. The defaults are the local stack (supabase/README.md), which
    the Android emulator reaches at 10.0.2.2. Builds for a hosted project pass -p:SupabaseUrl=… and
    -p:SupabasePublishableKey=…. A publishable key is public by design and ships in every app; never pass a secret key.
  -->
  <PropertyGroup>
    <SupabaseUrl Condition="'$(SupabaseUrl)' == '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">http://10.0.2.2:54321</SupabaseUrl>
    <SupabaseUrl Condition="'$(SupabaseUrl)' == ''">http://127.0.0.1:54321</SupabaseUrl>
    <SupabasePublishableKey Condition="'$(SupabasePublishableKey)' == ''">sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH</SupabasePublishableKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SupabaseUrl" Value="$(SupabaseUrl)" />
    <AssemblyMetadata Include="SupabasePublishableKey" Value="$(SupabasePublishableKey)" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitCore.Client.Auth\FitCore.Client.Auth.csproj" />
    <ProjectReference Include="..\FitCore.Client.Core\FitCore.Client.Core.csproj" />
  </ItemGroup>

</Project>
