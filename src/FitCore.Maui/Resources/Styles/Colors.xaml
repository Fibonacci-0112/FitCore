<?xml version="1.0" encoding="UTF-8" ?>
<!-- Text pairs meet 4.5:1 contrast in both themes (NFR-ACC-4). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#AC99EA</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#1A0B4F</Color>

    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#121212</Color>
    <Color x:Key="OnSurface">#1F1F1F</Color>
    <Color x:Key="OnSurfaceDark">#F2F2F2</Color>
    <Color x:Key="OnSurfaceMuted">#545454</Color>
    <Color x:Key="OnSurfaceMutedDark">#C8C8C8</Color>

    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>

</ResourceDictionary>
