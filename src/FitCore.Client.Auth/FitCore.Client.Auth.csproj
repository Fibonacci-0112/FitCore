    browsers (ADR 0005).
  -->

  <ItemGroup>
    <PackageReference Include="Supabase.Gotrue" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitCore.Client.Core\FitCore.Client.Core.csproj" />
  </ItemGroup>

</Project>
