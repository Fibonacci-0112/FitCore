@page "/"

<PageTitle>@ShellStrings.AppName</PageTitle>

<h1>@ShellStrings.AppName</h1>

<AuthorizeView>
    <Authorized>
        <p>@ShellStrings.HomeSignedIn</p>
    </Authorized>
    <NotAuthorized>
        <p><LinkedText Format="@ShellStrings.HomeIntro" Href="account/sign-up" Text="@AccountStrings.CreateAccountLink" data-enhance-nav="false" /></p>
    </NotAuthorized>
</AuthorizeView>
