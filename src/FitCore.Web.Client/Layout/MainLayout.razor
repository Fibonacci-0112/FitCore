@inherits LayoutComponentBase

<header>
    <nav aria-label="Account">
        <a href="">FitCore</a>
        <AuthorizeView>
            <Authorized>
                @* A plain form: sign-out is a full page load that clears what the browser cached (ADR 0005 decision 7). *@
                <form method="post" action="account/sign-out" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="account/sign-in" data-enhance-nav="false">Sign in</a>
                <a href="account/sign-up" data-enhance-nav="false">Create account</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main>
    @Body
</main>
