<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!-- Local development only (implementation plan §3.7): starts the Supabase CLI stack, then the web host and the worker. Never deployed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- DCP and the dashboard come from NuGet packages; the Aspire CLI bundle is not needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pins the Aspire SDK's transitive MessagePack to a patched version (Directory.Packages.props). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitCore.Web\FitCore.Web.csproj" />
    <ProjectReference Include="..\FitCore.Worker\FitCore.Worker.csproj" />
  </ItemGroup>

</Project>
