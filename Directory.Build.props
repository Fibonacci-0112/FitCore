<Project>

  <!-- Shared settings for src/ and tests/. spikes/ has its own Directory.Build.props and doesn't inherit these. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments on public members. Public surface is small and documented where it matters. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The language of the strings in Resources/*.resx; other languages are satellite assemblies (NFR-L10N-1, NFR-L10N-2). -->
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
