<Project>

  <!-- Central package management: every package version for src/ and tests/ is set here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Appium client for FitCore.Maui.UITests, which drives the Android app on an emulator in CI. -->
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <!-- Valkey for the AppHost; matches the Aspire AppHost SDK's version. -->
    <PackageVersion Include="Aspire.Hosting.Valkey" Version="13.6.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Transitive via the Aspire AppHost SDK; pinned past GHSA-qhrr-8q5h-9q3h (2.5.301 and 2.5.302). -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- The Valkey client for the shared rate-limit counters (ADR 0005 decision 9). -->
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <!-- Supabase Auth for the device apps, behind FitCore.Client.Auth (auth spike rule 5). Never in the web client (ADR 0005). -->
    <PackageVersion Include="Supabase.Gotrue" Version="8.4.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
  </ItemGroup>

</Project>
