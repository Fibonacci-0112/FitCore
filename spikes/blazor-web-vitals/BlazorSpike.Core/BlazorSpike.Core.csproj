<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- dotnet publish -p:SpikeNoYield=true builds the view model without the yield, for comparison. -->
    <DefineConstants Condition="'$(SpikeNoYield)' == 'true'">$(DefineConstants);SPIKE_NO_YIELD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
