@* The fragment the island swaps in after a save: new totals and the saved row, rendered with the same components. *@
<div id="totals">
    <TotalsView Totals="NutritionTotals.Sum(Day.Entries)" TargetKcal="Day.TargetKcal" TargetProteinG="Day.TargetProteinG" />
</div>
<DiaryRowView Entry="Added" Saved="true" />

@code {
    [Parameter, EditorRequired] public DiaryDayDto Day { get; set; } = default!;
    [Parameter, EditorRequired] public DiaryEntryDto Added { get; set; } = default!;
}
