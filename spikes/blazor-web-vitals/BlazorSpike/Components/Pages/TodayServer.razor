@page "/server"
@rendermode InteractiveServer
@inject IDiaryClient Diary

@* Reference only: Interactive Server keeps a circuit per tab, which NFR-SCL-2 rules out. *@
<PageTitle>Today (Interactive Server)</PageTitle>
<TodayView Model="model" />

@code {
    [PersistentState]
    public DiaryDayDto? Day { get; set; }

    private TodayViewModel? model;

    protected override async Task OnInitializedAsync()
    {
        Day ??= await Diary.GetTodayAsync();
        model = new TodayViewModel(Day, Diary);
    }
}
