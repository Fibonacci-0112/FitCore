<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FitCore Blazor Web Vitals spike" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <main>
        <Routes />
    </main>
    @* An islands page is plain HTML with its own script, so it doesn't load Blazor at all. *@
    @if (!HttpContext.Request.Path.StartsWithSegments("/islands"))
    {
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
