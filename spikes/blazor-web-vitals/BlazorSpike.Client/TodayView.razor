@inject IJSRuntime JS

@* The Today screen, rendered the same way by every variant. Only the page around it changes. *@
<h1>Today</h1>
@* Which renderer is running, for the measurement scripts: Static, Server or WebAssembly. *@
<span hidden data-renderer="@RendererInfo.Name" data-interactive="@RendererInfo.IsInteractive.ToString().ToLowerInvariant()"></span>
@if (Model is null)
{
    <p class="loading">Loading…</p>
}
else
{
    <TotalsView Totals="Model.Totals" TargetKcal="Model.TargetKcal" TargetProteinG="Model.TargetProteinG" />

    <button class="add" disabled="@(!RendererInfo.IsInteractive)" @onclick="Model.QuickAddCommand.ExecuteAsync">Add banana</button>

    <ol class="diary">
        @foreach (var row in Model.Rows)
        {
            <DiaryRowView @key="row.Entry.Id" Entry="row.Entry" Saved="row.Saved" Failed="row.Failed" />
        }
    </ol>
}

@code {
    [Parameter] public TodayViewModel? Model { get; set; }

    private bool marked;

    // Marks the moment the screen is both showing data and interactive, for the measurement scripts.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!marked && Model is not null && RendererInfo.IsInteractive)
        {
            marked = true;
            await JS.InvokeVoidAsync("performance.mark", "fitcore-ready");
        }
    }
}
